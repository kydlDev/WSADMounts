{
  "name": "ride-stop-on-release",
  "description": "D-018: releasing every key stops the mount (vanilla kept walking)",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "rideStart"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideInput",
      "args": {
        "x": 0,
        "z": 1,
        "seconds": 2,
        "run": false
      },
      "expect": "armed"
    },
    {
      "do": "wait",
      "seconds": 3.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "still",
        "min": 0.4
      },
      "expect": "ok",
      "label": "stands still (at most 0.4 m in 2 s) after the input ended"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
