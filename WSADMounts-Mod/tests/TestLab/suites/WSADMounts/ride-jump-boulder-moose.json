{
  "name": "ride-jump-boulder-moose",
  "description": "The ridden Moose jumps onto the boulder; side screenshots",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "jumpBoulder",
      "prefab": "Moose",
      "side": 0
    },
    {
      "do": "hook",
      "name": "WSADMounts.boulderLanded",
      "expect": "ok",
      "label": "the Moose landed on top of the boulder"
    },
    {
      "do": "hook",
      "name": "WSADMounts.sideCamOff",
      "expect": "side camera off"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
