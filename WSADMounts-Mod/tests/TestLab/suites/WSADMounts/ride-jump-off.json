{
  "name": "ride-jump-off",
  "description": "D-037: Enable Mount Jump off = Space dismounts as in the game, no jump",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "setConfig",
      "values": {
        "General/Enable Mount Jump": false
      }
    },
    {
      "do": "rideStart"
    },
    {
      "do": "hook",
      "name": "WSADMounts.riding",
      "expect": "riding True",
      "label": "riding before Space",
      "stop": true
    },
    {
      "do": "dismountedBy",
      "button": "Jump"
    },
    {
      "do": "hook",
      "name": "WSADMounts.lastMountAction",
      "expect": "none",
      "label": "no mount action ran"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
