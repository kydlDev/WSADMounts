{
  "name": "meta-ride-moved-fails",
  "description": "Negative test: 'moved forward' must FAIL when the mount got no input (proves the check can fail)",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "rideStart"
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "forward",
        "min": 2
      },
      "expect": "ok",
      "label": "must fail: no input was given"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ],
  "expectFailure": "bad: forward"
}
