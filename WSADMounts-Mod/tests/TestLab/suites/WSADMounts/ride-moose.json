{
  "name": "ride-moose",
  "description": "D-006: the Moose (a saddled mount of the game) steers camera-relative, stops on release and steps back facing ahead - MOONWALK style (D-032: the walk clip played backwards)",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "rideStart",
      "prefab": "Moose"
    },
    {
      "do": "setConfig",
      "values": {
        "Animation/Backward Animation": "Moonwalk"
      },
      "label": "MOONWALK: rider picks the Moonwalk style"
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideInput",
      "args": {
        "x": 0,
        "z": 1,
        "seconds": 3,
        "run": false
      },
      "expect": "armed"
    },
    {
      "do": "wait",
      "seconds": 3.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "forward",
        "min": 2
      },
      "expect": "ok",
      "label": "the Moose walks ahead of the camera"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "still",
        "min": 0.4
      },
      "expect": "ok",
      "label": "the Moose stopped when the input ended"
    },
    {
      "do": "backStepStart",
      "look": "MOONWALK"
    },
    {
      "do": "hook",
      "name": "WSADMounts.backState",
      "contains": "back True",
      "label": "MOONWALK: the Moose steps back"
    },
    {
      "do": "hook",
      "name": "WSADMounts.walkAnimating",
      "expect": "ok",
      "label": "MOONWALK: the Moose's walk animation plays (base animator layer under the clip)"
    },
    {
      "do": "moonwalkCheck"
    },
    {
      "do": "wait",
      "seconds": 2.5,
      "label": "MOONWALK: wait"
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "back",
        "min": 0.8
      },
      "expect": "ok",
      "label": "MOONWALK: the Moose moved at least 0.8 m backwards"
    },
    {
      "do": "hook",
      "name": "WSADMounts.facingKept",
      "args": {
        "maxDeg": 25
      },
      "expect": "ok",
      "label": "MOONWALK: the Moose still faces ahead"
    },
    {
      "do": "backStepEnd",
      "label": "side camera off, style back to default, mount removed, arena cleaned"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}