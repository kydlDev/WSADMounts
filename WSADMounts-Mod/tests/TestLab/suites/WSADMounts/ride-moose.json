{
  "name": "ride-moose",
  "description": "D-006: the Moose (a saddled mount of the game) steers camera-relative, stops on release and steps back facing ahead with the Moonwalk",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "rideStart",
      "prefab": "Moose"
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideInput",
      "args": {
        "x": 0,
        "z": 1,
        "seconds": 3,
        "run": false
      },
      "expect": "armed"
    },
    {
      "do": "wait",
      "seconds": 3.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "forward",
        "min": 2
      },
      "expect": "ok",
      "label": "the Moose walks ahead of the camera"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "still",
        "min": 0.4
      },
      "expect": "ok",
      "label": "the Moose stopped when the input ended"
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideInput",
      "args": {
        "x": 0,
        "z": -1,
        "seconds": 4,
        "run": false
      },
      "expect": "armed"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.backState",
      "contains": "back True",
      "label": "the Moose steps back"
    },
    {
      "do": "hook",
      "name": "WSADMounts.walkAnimating",
      "expect": "ok",
      "label": "the Moose's walk animation plays (Moonwalk)"
    },
    {
      "do": "wait",
      "seconds": 2.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "back",
        "min": 0.8
      },
      "expect": "ok",
      "label": "the Moose moved at least 0.8 m backwards"
    },
    {
      "do": "hook",
      "name": "WSADMounts.facingKept",
      "args": {
        "maxDeg": 25
      },
      "expect": "ok",
      "label": "the Moose still faces ahead"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
