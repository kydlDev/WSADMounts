{
  "name": "ride-sideways",
  "description": "D-004: D (right input) walks the mount to the right of the camera, A to the left",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "rideStart"
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideInput",
      "args": {
        "x": 1,
        "z": 0,
        "seconds": 3,
        "run": false
      },
      "expect": "armed"
    },
    {
      "do": "wait",
      "seconds": 3.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "right",
        "min": 1.5
      },
      "expect": "ok",
      "label": "moved at least 1.5 m to the camera's right"
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideInput",
      "args": {
        "x": -1,
        "z": 0,
        "seconds": 3,
        "run": false
      },
      "expect": "armed"
    },
    {
      "do": "wait",
      "seconds": 3.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "left",
        "min": 1.5
      },
      "expect": "ok",
      "label": "moved at least 1.5 m to the camera's left"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
