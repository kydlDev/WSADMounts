{
  "name": "ride-real-key",
  "description": "The real Forward key (the game's own input path, not the test input) walks the mount ahead",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "rideStart"
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "pressKey",
      "button": "Forward",
      "frames": 150
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "forward",
        "min": 1
      },
      "expect": "ok",
      "label": "moved at least 1 m ahead with the real key"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
