{
  "name": "feature-toggle",
  "description": "Enable Mod off stops the riding feature (mounts ride as in the normal game), on starts it again (PROJECT_RULES 11 / 17, D-010)",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "WSADMounts.featureRunning",
      "args": {
        "id": "riding"
      },
      "expect": true,
      "label": "running at start"
    },
    {
      "do": "setConfig",
      "values": {
        "General/Enable Mod": false
      }
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "WSADMounts.featureRunning",
        "args": {
          "id": "riding"
        },
        "expect": false
      },
      "timeout": 5
    },
    {
      "do": "setConfig",
      "values": {
        "General/Enable Mod": true
      }
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "WSADMounts.featureRunning",
        "args": {
          "id": "riding"
        },
        "expect": true
      },
      "timeout": 5
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
