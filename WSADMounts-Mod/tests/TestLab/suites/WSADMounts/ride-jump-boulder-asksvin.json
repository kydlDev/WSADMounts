{
  "name": "ride-jump-boulder-asksvin",
  "description": "The ridden Asksvin jumps onto the boulder; side screenshots",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "jumpBoulder",
      "prefab": "Asksvin",
      "side": 0
    },
    {
      "do": "hook",
      "name": "WSADMounts.boulderLanded",
      "expect": "ok",
      "label": "the Asksvin landed on top of the boulder"
    },
    {
      "do": "hook",
      "name": "WSADMounts.jumpClip",
      "contains": "WSADMounts_Asksvin_Jump: left the ground True",
      "label": "JUMP CLIP: the Asksvin played its hand-made jump onto the boulder"
    },
    {
      "do": "hook",
      "name": "WSADMounts.sideCamOff",
      "expect": "side camera off"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
