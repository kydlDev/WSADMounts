{
  "name": "ride-stick-back-half",
  "description": "Controller: a stick pulled back half way (z = -0.5, past the 0.3 threshold) also steps back - default style BackwardWalk shows the MOONWALK (fallback) until the hand-made clip exists",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "rideStart"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideInput",
      "args": {
        "x": 0,
        "z": -0.5,
        "seconds": 3,
        "run": false
      },
      "expect": "armed",
      "label": "MOONWALK (fallback): rideInput"
    },
    {
      "do": "wait",
      "seconds": 1.5,
      "label": "MOONWALK (fallback): wait"
    },
    {
      "do": "hook",
      "name": "WSADMounts.backState",
      "contains": "back True",
      "label": "MOONWALK (fallback): stick -0.5 steps back"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
