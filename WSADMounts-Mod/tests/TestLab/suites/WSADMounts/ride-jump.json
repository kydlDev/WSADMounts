{
  "name": "ride-jump",
  "description": "D-037: Space makes the ridden Lox jump (game jump, rider stays on)",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "rideStart"
    },
    {
      "do": "hook",
      "name": "WSADMounts.riding",
      "expect": "riding True",
      "label": "riding before the jump",
      "stop": true
    },
    {
      "do": "hook",
      "name": "WSADMounts.airMark",
      "contains": "air marked",
      "stop": true
    },
    {
      "do": "mountActionCheck",
      "button": "Jump",
      "expect": "Jump started",
      "settle": 1.2
    },
    {
      "do": "hook",
      "name": "WSADMounts.airPeak",
      "args": {
        "min": 0.4
      },
      "expect": "ok",
      "label": "the Lox left the ground at least 0.4 m"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
