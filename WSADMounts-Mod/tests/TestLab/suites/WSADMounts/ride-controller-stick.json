{
  "name": "ride-controller-stick",
  "description": "D-024: a controller (faked left stick at ZInput.GetJoyLeftStick, the game's own input path) steers camera-relative and steps back (the back step is marked after a short forward walk: it keeps facing the CAMERA direction, D-005) - default style BackwardWalk: the hand-made BACKWARD WALK clip (D-034)",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "WSADMounts.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "rideStart"
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "hook",
      "name": "WSADMounts.stick",
      "args": {
        "x": 0,
        "y": 1,
        "seconds": 3
      },
      "expect": "armed"
    },
    {
      "do": "wait",
      "seconds": 3.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "forward",
        "min": 2
      },
      "expect": "ok",
      "label": "stick forward: walks ahead of the camera"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "hook",
      "name": "WSADMounts.stick",
      "args": {
        "x": 0.8,
        "y": 0,
        "seconds": 3
      },
      "expect": "armed"
    },
    {
      "do": "wait",
      "seconds": 3.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "right",
        "min": 1.5
      },
      "expect": "ok",
      "label": "stick right (0.8): walks to the camera's right"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.stick",
      "args": {
        "x": 0,
        "y": 1,
        "seconds": 2
      },
      "expect": "armed"
    },
    {
      "do": "wait",
      "seconds": 2.5
    },
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked"
    },
    {
      "do": "hook",
      "name": "WSADMounts.stick",
      "args": {
        "x": 0,
        "y": -0.6,
        "seconds": 4
      },
      "expect": "armed",
      "label": "BACKWARD WALK: stick"
    },
    {
      "do": "wait",
      "seconds": 1.5,
      "label": "BACKWARD WALK: wait"
    },
    {
      "do": "hook",
      "name": "WSADMounts.backState",
      "contains": "back True",
      "label": "BACKWARD WALK: stick pulled back (-0.6): steps back"
    },
    {
      "do": "wait",
      "seconds": 2.5,
      "label": "BACKWARD WALK: wait"
    },
    {
      "do": "hook",
      "name": "WSADMounts.moved",
      "args": {
        "dir": "back",
        "min": 0.8
      },
      "expect": "ok",
      "label": "BACKWARD WALK: stick back: moved at least 0.8 m backwards"
    },
    {
      "do": "hook",
      "name": "WSADMounts.facingKept",
      "args": {
        "maxDeg": 25
      },
      "expect": "ok",
      "label": "BACKWARD WALK: stick back: still faces ahead"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideReset",
      "expect": "reset"
    },
    {
      "do": "cleanArena"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WSADMounts"
    }
  ]
}
