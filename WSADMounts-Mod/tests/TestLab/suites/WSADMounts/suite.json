{
  "name": "WSADMounts",
  "description": "WSADMounts: loads with its exact KydlCore, registers its KY hub page, every feature switches live, its commands reach the real handlers (MIGRATION_DECISIONS C14-C21)",
  "requireMods": [
    {
      "guid": "com.kydldev.WSADMounts",
      "minVersion": "0.1.0"
    },
    {
      "guid": "com.kydldev.KydlCore",
      "minVersion": "1.1.1"
    }
  ],
  "configOverrides": [
    {
      "guid": "com.kydldev.WSADMounts",
      "section": "General",
      "key": "Enable Mod",
      "value": "true"
    },
    {
      "guid": "com.kydldev.WSADMounts",
      "section": "General",
      "key": "Enable Custom Controls",
      "value": "true"
    },
    {
      "guid": "com.kydldev.WSADMounts",
      "section": "Animation",
      "key": "Backward Animation",
      "value": "BackwardWalk"
    },
    {
      "guid": "com.kydldev.WSADMounts",
      "section": "DebugLog",
      "key": "Enable",
      "value": "true"
    }
  ],
  "setup": {
    "timeOfDay": 0.5,
    "freezeTime": 1,
    "god": 1,
    "hideUnlockPopups": 1
  },
  "resetBetweenTests": true,
  "tests": [
    "startup-clean",
    "hub-page",
    "feature-toggle",
    "ride-forward",
    "ride-sideways",
    "ride-stop-on-release",
    "ride-back-step",
    "ride-back-speed",
    "ride-stick-back-half",
    "ride-controls-off",
    "ride-real-key",
    "meta-ride-moved-fails",
    "ride-asksvin",
    "ride-moose",
    "ride-controller-stick",
    "ride-viewer-bjornita"
  ]
}