{
  "params": [
    {
      "look": "BACK STEP"
    }
  ],
  "actions": [
    {
      "do": "hook",
      "name": "WSADMounts.mark",
      "expect": "marked",
      "label": "{{look}}: start mark"
    },
    {
      "do": "hook",
      "name": "WSADMounts.sideCam",
      "args": {
        "metres": 9
      },
      "expect": "side camera on",
      "label": "{{look}}: side camera on (for the person watching the run)"
    },
    {
      "do": "hook",
      "name": "WSADMounts.rideInput",
      "args": {
        "x": 0,
        "z": -1,
        "seconds": 4,
        "run": false
      },
      "expect": "armed",
      "label": "{{look}}: S held for 4 s (back step)"
    },
    {
      "do": "wait",
      "seconds": 1.5,
      "label": "{{look}}: let the back step start"
    }
  ],
  "asserts": []
}
